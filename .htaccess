Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Documentacion, scripts de instalacion/escritorio y logs no deben servirse por web.
<FilesMatch "(?i)\.(md|sql|ps1|bat|iss|vbs|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
    RewriteRule ^(?:SQL|database|desktop|src|storage|\.vscode|\.git)(?:/|$) - [F,L,NC]
</IfModule>
