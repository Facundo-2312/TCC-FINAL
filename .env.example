# Copia este archivo a .env y reemplaza los valores ficticios por los reales de tu entorno.
# NUNCA subas el archivo .env real (con credenciales reales) al repositorio.
# Si el hosting permite variables de entorno desde el panel, puedes definirlas alli en vez de usar .env.
# Sin .env ni variables, la app usa los valores por defecto de XAMPP local
# (localhost / root / sin contrasena / ProyectoMagnus).

# development | production (production oculta detalles de errores/excepciones)
APP_ENV=production

# Zona horaria de PHP y de la sesion MySQL (por defecto America/Montevideo)
APP_TIMEZONE=America/Montevideo

# Subcarpeta donde vive la app si no esta en la raiz del document root (ej: /proj). Vacio = raiz.
APP_BASE_PATH=

# Base de datos (valores ficticios)
APP_DB_HOST=sqlXXX.tu-hosting.example
APP_DB_USER=usuario_mysql
APP_DB_PASSWORD=cambia-esta-contrasena
APP_DB_NAME=nombre_de_la_base
APP_DB_CHARSET=utf8mb4

# Variables estandar de Railway/PaaS (APP_DB_* tiene prioridad). Puerto por defecto: 3306.
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# APP_DB_PORT=3306

# Set to 0 on hosting that does not allow MySQL triggers so PHP manages stock.
APP_DB_STOCK_TRIGGERS=1

# Ruta del log de seguridad (intentos de login, CSRF, errores de BD). Vacio = storage/logs/security.log
# Debe tener permiso de escritura y, idealmente, estar fuera del document root.
APP_SECURITY_LOG_PATH=

# Notificaciones de reservas (opcional; desactivadas por defecto)
NOTIF_EMAIL_ENABLED=false
NOTIF_EMAIL_FROM=reservas@tu-dominio.example
NOTIF_SMS_ENABLED=false
NOTIF_SMS_PROVIDER=twilio
NOTIF_SMS_API_KEY=
